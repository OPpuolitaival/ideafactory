# Authentication (required — or use Claude Code session auth)
# ANTHROPIC_API_KEY=sk-ant-xxx

# Model versions — override the model ID for each tier
# HAIKU_MODEL=claude-haiku-4-5-20251001
# SONNET_MODEL=claude-sonnet-4-5-20250929
# OPUS_MODEL=claude-opus-4-6

# Model assignment per agent role (defaults to MODEL_DEFAULT, which defaults to opus)
# MODEL_DEFAULT=claude-opus-4-6
# MODEL_NAVIGATOR=claude-opus-4-6
# MODEL_STRATEGIST=claude-opus-4-6
# MODEL_WORKER=claude-opus-4-6
# MODEL_ANALYST=claude-opus-4-6

# Server
# PORT=3000

# Pipeline defaults
# IDEAS_PER_WORKER=15
# WEB_SEARCH=false
